GEMINAL:
  Default g optimizability: fixed
  Default c optimizability: fixed
  Geminal 1:
    Parameters:
      c: [  1.00000000e+00, fixed ]
      g_1,1: [  1.00000000e+00, fixed ]
      g_2,2: [  1.00000000e+00, fixed ]
  Geminal 2:
    Parameters:
      c: [  1.00000000e+00, fixed ]
      g_1,1: [  1.00000000e+00, fixed ]
      g_3,3: [ -1.63080625e-01, optimizable ]
      g_6,6: [ -2.84047648e-02, optimizable ]
  Geminal 3:
