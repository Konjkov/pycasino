GEMINAL:
  Default g optimizability: fixed
  Default c optimizability: fixed
  Geminal 1:
    Parameters:
      c: [ 1.0, fixed ]
      g_1,1: [ 1.0, fixed ]
      g_2,2: [ 1.0, fixed ]
  Geminal 2:
    Parameters:
      c: [ 1.0, fixed ]
      g_1,1: [ 1.0, fixed ]
      g_3,3: [ -0.186464, optimizable ]
      g_6,6: [ -0.043827, optimizable ]
  Geminal 3:
